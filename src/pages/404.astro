---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.js';
import Icon from '../components/Icon.astro';
---
<Base noindex title="Page not found · Francesca Folkmer" description="This page doesn't exist. Head back to the homepage.">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1 class="h1">Oops, you got lost.</h1>
    <p class="lead">Don't worry, you can always go back.</p>
    <p><a class="roll" href={url('/')}><span>Back to the homepage</span><span class="roll__ball" aria-hidden="true"><Icon name="arrow-left" size={22} /></span></a></p>
  </section>
</Base>

<style>
  .nf { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; padding-top: clamp(120px, 16vw, 200px); padding-bottom: clamp(72px, 10vw, 160px); }
  .nf .lead { max-width: 40ch; color: var(--ink-2); }
</style>
