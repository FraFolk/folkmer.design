---
import Base from '../layouts/Base.astro';
import CaseIntro from '../components/CaseIntro.astro';
import AleTimeline from '../components/AleTimeline.astro';
import { url } from '../lib/url.js';
import Icon from '../components/Icon.astro';

const screens = [
  ['ale-s-home', 'Home: search for a spot and your next adventure'],
  ['ale-s-map', 'Map with a selected spot'],
  ['ale-s-search', 'Search with recent places'],
  ['ale-s-filters', 'Filters: type, grade, rock, holds'],
  ['ale-s-spot', 'Boulder spot: blocks and grade distribution'],
  ['ale-s-event', 'Official event page: Melloblocco 2026'],
  ['ale-s-profile', 'Climber profile with grades and stats'],
  ['ale-s-settings', 'Settings, with a "buy us a beer" card'],
];
const dock = [
  { name: 'Perplexity', img: 'dock-perplexity.webp' },
  { name: 'Gemini', img: 'dock-gemini.webp' },
  { name: 'Figma', img: 'dock-figma.webp' },
  { name: 'Users', img: null },
  { name: 'Antigravity', img: 'dock-antigravity.webp' },
];

---
<Base title="Alé: building an app for climbers · Francesca Folkmer"
  description="Alé is a community app for climbers that Francesca Folkmer co-founded. From discovery to launch, with AI in the workflow.">
  <article class="container case">
    <CaseIntro
      tags={['Co-founder', 'Product Discovery', 'AI Workflow', 'Mobile App']}
      title="Alé: an app for climbers, by climbers"
      facts={[['Timeline', 'Jul 2025 - Now'], ['Role', 'Co-founder & Product Design Lead'], ['Team', '2 founders, 1 developer, 1 designer']]}
    >
      <Fragment slot="media"><AleTimeline /></Fragment>
      <p>I co-founded Alé with Marta. We make the business decisions together, and I lead the product design: from the first survey to the MVP.</p>
    </CaseIntro>

    <section class="split" aria-labelledby="challenge">
      <div class="split__text reveal">
        <div class="split__title">
          <p class="eyebrow">The challenge</p>
          <h2 id="challenge" class="h2">"Finding the right spot shouldn't be harder than the climb."</h2>
        </div>
        <div class="prose">
          <p>Climbing information is scattered between <b>expensive, outdated guidebooks</b> and <b>fragmented forums</b>.</p>
          <ul>
            <li><b>The gap:</b> no single, up-to-date place to find, share and update climbing spots.</li>
            <li><b>The friction:</b> beginners don't know where to start, experts waste time scouting new places.</li>
          </ul>
        </div>
      </div>
      <div class="split__media questions reveal" aria-hidden="true">
        <img src={url('/img/ale-challenge.webp')} alt="" />
        <span class="q q--0">Does it have chains?</span>
        <span class="q q--1">What's it graded?</span>
        <span class="q q--2">Is the pitch clean?</span>
      </div>
    </section>

    <section class="split split--media-first" aria-labelledby="strategy">
      <div class="split__media dock-scene reveal" aria-hidden="true">
        <img class="dock-scene__rock" src={url('/img/rock.webp')} alt="" />
        <div class="dock" data-dock>
          {dock.map((d) => (
            <span class="dock__item">
              {d.img ? <img src={url(`/img/${d.img}`)} alt="" /> : (
                <span class="dock__users">
                  <img src={url('/img/dock-users-base.svg')} alt="" />
                  <img class="dock__users-icon" src={url('/img/dock-users-icon.svg')} alt="" />
                </span>
              )}
            </span>
          ))}
        </div>
      </div>
      <div class="split__text reveal">
        <div class="split__title">
          <p class="eyebrow">The strategy</p>
          <h2 id="strategy" class="h2">People first, then AI</h2>
        </div>
        <div class="prose">
          <p>We started from climbers: a <b>survey with 50+ people</b> and <b>5 in-depth interviews</b>. Then I used AI to speed up the parts that don't need a human:</p>
          <ul>
            <li><b>Benchmarking:</b> analysing existing outdoor apps to find the gaps.</li>
            <li><b>Synthesis:</b> turning answers into personas and journeys, then checking them against the interviews.</li>
            <li><b>Prototyping in code:</b> working side by side with our developer, with AI helping both of us move faster.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="split" aria-labelledby="solution">
      <div class="split__text reveal">
        <div class="split__title">
          <p class="eyebrow">The solution</p>
          <h2 id="solution" class="h2">Designed by climbers, for climbers</h2>
        </div>
        <div class="prose">
          <p>Alé is more than a map: it's the community that keeps the information alive.</p>
          <ul>
            <li><b>Crowdsourced spots:</b> suggest, rate and update spots with real-time conditions.</li>
            <li><b>Community grades:</b> the official grade next to the community one. Because we all know it's never the same.</li>
            <li><b>Community wisdom:</b> tips on gear, difficulty and safety, from climbers to climbers.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="phones" aria-label="Alé screens">
      <ul class="phones__row" data-phones>
        {screens.map(([img, alt]) => (
          <li class="phones__item">
            <div class="phone-mock">
              <img class="phone-mock__screen" src={url(`/img/${img}.webp`)} alt={alt} loading="lazy" width="375" height="812" />
              <img class="phone-mock__frame" src={url('/img/phone-frame-2.svg')} alt="" />
            </div>
          </li>
        ))}
      </ul>
      <div class="phones__bar" data-phones-bar aria-hidden="true"><span></span></div>
    </section>


    <section class="retro reveal" aria-labelledby="soon">
      <h2 id="soon" class="h2 soon">No more spoilers for now.<br />The launch is just around the corner.</h2>
      <p>Coming to the stores in <b>December 2026</b>. Want to be among the first climbers to try it?</p>
      <p class="retro__cta"><a class="roll" href="https://aleclimbing.app/" target="_blank" rel="noopener">
        <span>Join the waiting list<span class="sr-only"> (opens aleclimbing.app in a new tab)</span></span>
        <span class="roll__ball" aria-hidden="true"><Icon name="arrow-up-right" size={22} /></span>
      </a></p>
    </section>
  </article>
</Base>

<style>
  /* phone mockup (Figma "iphone 15") */
  .phone { position: absolute; aspect-ratio: 143.44 / 298.22; }
  .phone__frame { position: absolute; inset: 0; width: 100%; height: 100%; }
  .phone__screen { position: absolute; left: 3.36%; top: 1.38%; width: 93.9%; height: 97.24%; object-fit: cover; border-radius: 6% / 3%; }
  .ale-hero__phone { left: 44.6%; top: 20.6%; height: 57.3%; animation: rise 1.2s var(--ease-out) .2s both; }
  @keyframes rise { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }

  /* Challenge: questions pop in */
  .questions { aspect-ratio: 540 / 363; border-radius: var(--radius-l); }
  .questions > img { width: 100%; height: 100%; object-fit: cover; object-position: bottom; border-radius: var(--radius-l); }
  .q {
    position: absolute; white-space: nowrap;
    background: #fff; border: 2.5px solid var(--line);
    border-radius: 30px 2.5px 30px 30px; padding: 8px 24px 8px 24px;
    font-size: clamp(14px, 1.2vw, 18px);
    filter: drop-shadow(5px 5px 6px rgba(42,47,45,.1));
    opacity: 0; transform: scale(.7) translateY(10px); transform-origin: 100% 0;
    transition: opacity .3s ease, transform .6s var(--ease-spring);
  }
  .q--0 { left: -12%; top: 54%; }
  .q--1 { left: 3%; top: 73%; }
  .q--2 { right: -6%; top: 79%; border-radius: 2.5px 30px 30px 30px; transform-origin: 0 0; }
  .reveal.is-in .q { opacity: 1; transform: none; }
  .reveal.is-in .q--0 { transition-delay: .3s; }
  .reveal.is-in .q--1 { transition-delay: .9s; }
  .reveal.is-in .q--2 { transition-delay: 1.5s; }

  /* Strategy: macOS-like dock on a rock, magnifies on hover */
  .dock-scene { aspect-ratio: 640 / 416; }
  .dock-scene__rock { position: absolute; left: 15%; top: 45%; width: 67%; }
  .dock {
    position: absolute; left: 13%; top: 49%; width: 74%; height: 23%;
    display: flex; justify-content: center; align-items: flex-end; gap: 2%;
    padding: 0 2% 3%;
    background: rgba(255,255,255,.1);
    border: 1.7px solid rgba(255,255,255,.54);
    border-radius: var(--radius-l);
    backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
  }
  .dock__item { width: 16%; aspect-ratio: 1; transform-origin: 50% 100%; transition: transform .25s var(--ease-out); }
  .dock__item img { width: 100%; height: 100%; }
  .dock__users { position: relative; display: block; width: 100%; height: 100%; }
  .dock__users img { position: absolute; inset: 0; }
  .dock__users .dock__users-icon { inset: 22%; width: 56%; height: 56%; }

  /* Solution: a row of iPhones; drag (mouse) or swipe to scroll */
  .phones { margin-top: calc(clamp(80px, 10vw, 180px) * -0.5); }
  .phones__row { list-style: none; margin: 0; padding: 8px 0 24px; display: flex; gap: 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; }
  .phones__row::-webkit-scrollbar { display: none; }
  .phones__row.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .phones__item { flex: 0 0 clamp(150px, 17vw, 230px); scroll-snap-align: start; }
  .phone-mock { position: relative; aspect-ratio: 143.44 / 298.22; }
  .phone-mock__frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .phone-mock__screen { position: absolute; left: 3.36%; top: 1.38%; width: 93.9%; height: 97.24%; object-fit: cover; border-radius: 9% / 4.3%; }
  /* one progress bar: thumb = the visible share of the row, it slides as you scroll */
  .phones__bar { position: relative; width: min(240px, 50%); height: 4px; margin: 16px auto 0; border-radius: var(--radius-pill); background: var(--line); overflow: hidden; }
  .phones__bar span { position: absolute; left: 0; top: 0; bottom: 0; width: var(--w, 30%); border-radius: inherit; background: var(--ink); transform: translateX(var(--x, 0)); }
  @media (max-width: 760px) { .phones__row { gap: 16px; } .phones__item { flex-basis: calc((100% - 16px) / 2.3); } }
  .float { animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-10px); } }

  .soon { color: var(--orange-text); text-align: center; }
  .retro a { text-underline-offset: 3px; }
  .retro__cta { margin-top: 24px; }

  /* Founder diary: a light timeline with ticks */

  @media (max-width: 900px) {
    .q--0 { left: 4%; }
    .q--2 { right: 4%; }
  }
</style>

<script>
  // iPhone row: drag with the mouse to scroll (touch scrolls natively)
  const row = document.querySelector('[data-phones]');
  if (row) {
    let x0 = null, s0 = 0;
    row.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; x0 = e.clientX; s0 = row.scrollLeft; row.classList.add('is-dragging'); row.setPointerCapture(e.pointerId); });
    row.addEventListener('pointermove', (e) => { if (x0 !== null) row.scrollLeft = s0 - (e.clientX - x0); });
    const end = () => { x0 = null; row.classList.remove('is-dragging'); };
    row.addEventListener('pointerup', end); row.addEventListener('pointercancel', end);
    row.addEventListener('dragstart', (e) => e.preventDefault());
    // progress bar: thumb width = visible share, position = how far you scrolled
    const bar = document.querySelector('[data-phones-bar]');
    const thumb = bar.firstElementChild;
    const update = () => {
      const max = row.scrollWidth - row.clientWidth;
      bar.hidden = max <= 2;
      const w = (row.clientWidth / row.scrollWidth) * bar.clientWidth;
      thumb.style.setProperty('--w', `${w}px`);
      thumb.style.setProperty('--x', `${max > 0 ? (row.scrollLeft / max) * (bar.clientWidth - w) : 0}px`);
    };
    row.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update); update();
  }

  // Dock magnification (mouse only; purely decorative)
  const dock = document.querySelector('[data-dock]');
  if (dock && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    const items = [...dock.children];
    dock.addEventListener('mousemove', (e) => {
      for (const it of items) {
        const r = it.getBoundingClientRect();
        const d = Math.abs(e.clientX - (r.left + r.width / 2));
        const s = 1 + Math.max(0, 0.5 - d / 260);
        it.style.transform = `scale(${s.toFixed(3)})`;
      }
    });
    dock.addEventListener('mouseleave', () => items.forEach((it) => (it.style.transform = '')));
  }
</script>
