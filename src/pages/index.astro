---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import LabCarousel from '../components/LabCarousel.astro';
import Whiteboard from '../components/Whiteboard.astro';
import Icon from '../components/Icon.astro';
import { projects, ale } from '../lib/projects.js';
import { url } from '../lib/url.js';

// Figma hero: three colleague comments that appear one at a time and "type" their text.
const quotes = [
  { name: 'Axel, Senior Digital Designer', text: 'A true reference point for the entire team.', tone: 'orange', cursor: 'cursor-orange.svg' },
  { name: 'Bianca, Design Lead', text: 'Her proactivity and attention to detail are outstanding.', tone: 'green', cursor: 'cursor-green.svg' },
  { name: 'Renato, Lead Designer', text: 'A proactive force who innovated our core design framework for the future.', tone: 'grey', cursor: 'cursor-grey.svg' },
];
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__intro">
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">Product Designer</h1>
        <p class="hero__sub">Accessibility &amp; AI · Co-founder of <a href={url('/ale/')}>Alé</a></p>
        <p class="hero__body">I turn complex services into simple, accessible products. With a soft spot for AI and a hard rule on contrast.</p>
      </div>
      <div class="hero__actions">
        <a class="cta" href={url('/about/')} data-slide-to-about>
          <span>About me</span>
          <span class="cta__arrow"><Icon name="arrow-right" size={20} /></span>
        </a>
        <a class="cta cta--ghost" href="#work">
          <span>See what I do</span>
          <span class="cta__arrow"><Icon name="arrow-down" size={20} /></span>
        </a>
      </div>
    </div>

    <figure class="quotes" aria-label="What colleagues say">
      <ul class="sr-only">
        {quotes.map((q) => <li><blockquote>{q.text}</blockquote> <cite>{q.name}</cite></li>)}
      </ul>
      <div class="quotes__stage" aria-hidden="true">
        {quotes.map((q, i) => (
          <div class={`bubble bubble--${q.tone} bubble--p${i}`} data-quote={q.text}>
            <img class="bubble__cursor" src={url(`/img/${q.cursor}`)} alt="" width="29" height="30" />
            <div class="bubble__box">
              <span class="bubble__name">{q.name}</span>
              <span class="bubble__text"><span class="bubble__typed"></span><span class="bubble__ghost">{q.text}</span></span>
            </div>
          </div>
        ))}
      </div>
    </figure>
  </section>

  <!-- 1. End to end: the story first, the (secret) project below -->
  <section id="work" class="story container" aria-labelledby="e2e-title" tabindex="-1">
    <h2 id="e2e-title" class="h1 story__title reveal">I follow products from the first workshop to the last handoff.</h2>
    <p class="story__lead reveal">On big products I don't stop at the screens: functional analysis, flows, UI, and the developers' questions on a Friday afternoon.</p>
    <a class="secret-case reveal" href={url('/work/aon/')}>
      <span class="secret-case__text">
        <span class="secret-case__tags">Insurance · End-to-end · Ownership</span>
        <span class="secret-case__title">Joined to execute. Ended up owning the design.</span>
        <span class="secret-case__sub">An insurance platform where I became the only design reference. The details stay offline: move the torch around, or ask me in person.</span>
        <span class="secret-case__cta">Open the case <Icon name="arrow-right" size={18} /></span>
      </span>
      <span class="secret-case__cover"><Cover kind="nda" /></span>
    </a>
  </section>

  <!-- 2. Accessibility: starts from the certification -->
  <section class="story container" aria-labelledby="a11y-title">
    <h2 id="a11y-title" class="h1 story__title reveal cert">I make <mark class="cert__mark">accessibility</mark> the first step, not the last fix.</h2>
    <p class="story__lead reveal">I'm <b>CPACC-certified</b>. I review the accessibility strategy, build it into the components and explain the why to the people who write the code. On real projects, it looks like this.</p>
    <a class="a11y reveal" href={url('/work/accessibility/')}>
      <span class="a11y__stat" aria-hidden="true">
        <span class="a11y__from">50%</span><span class="a11y__arrow">→</span><span class="a11y__to">85%</span>
      </span>
      <span class="a11y__text">
        <span class="a11y__title">{projects[0].title}</span>
        <span>300+ defects kept coming back, so we stopped chasing bugs and changed the process. Then we measured it: two touchpoints now pass every criterion.</span>
        <span class="sr-only">Compliance went from 50% to 85%.</span>
        <span class="a11y__cta">Read the case <Icon name="arrow-right" size={18} /></span>
      </span>
    </a>
  </section>

  <!-- 3. Plot twist: Alé -->
  <section class="story container" aria-labelledby="ale-title">
    <h2 id="ale-title" class="h1 story__title plot reveal">
      <span class="sr-only">Plot twist: I'm also a climber, and a co-founder.</span>
      <span aria-hidden="true">Plot twist: I'm also a <span class="plot__old">climber</span> <span class="plot__new">co-founder</span>.</span>
    </h2>
    <p class="story__lead reveal">I love climbing. I'm just not very good at it. So I took it to the one place where I know what I'm doing: design. Alé is an app for climbers, built by four of us in the evenings and at weekends. I lead the product design.</p>
    <a class="ale-card reveal" href={url('/ale/')}>
      <img src={url(ale.image)} alt="" width="662" height="395" loading="lazy" />
      <span class="ale-card__body">
        <span class="ale-card__title">Alé, from the inside</span>
        <span class="ale-card__facts" aria-hidden="true"><span><b>50+</b> climbers surveyed</span><span><b>5</b> interviews</span><span><b>4</b> people</span><span>Launch <b>Dec 2026</b></span></span>
        <span class="ale-card__cta">Follow the journey <Icon name="arrow-right" size={18} /></span>
      </span>
    </a>
  </section>

  <!-- 4. Lab: the flask tips over, the spill becomes the stage for the cards -->
  <section class="lab-section" aria-labelledby="lab-title" data-lab>
    <div class="container lab-head">
      <h2 id="lab-title" class="lab-head__title">
        <span class="flask" aria-hidden="true">
          <svg viewBox="7.75 4.75 32.5 40.5"><path class="flask__glass" d="M18 6h12M20 6v12L9 38a4 4 0 0 0 3.5 6h23A4 4 0 0 0 39 38L28 18V6" /><path class="flask__liquid" d="M14.6 30h18.8L37 37.5a3 3 0 0 1-2.7 4.5H13.7a3 3 0 0 1-2.7-4.5z" /></svg>
          <span class="flask__drop"></span>
        </span>
        Lab
      </h2>
      <p>What I build and explore with AI.</p>
    </div>
    <div class="lab-stage">
      <svg class="spill" viewBox="0 0 1400 620" preserveAspectRatio="none" aria-hidden="true">
        <path d="M612 52c58-14 96 22 148 18 66-5 92-46 162-38 84 9 96 72 168 84 78 13 150-26 214 18 58 40 26 104 44 156 20 58 82 84 60 150-24 72-118 74-180 104-70 34-64 96-142 118-86 24-136-34-218-28-74 6-108 62-188 58-82-4-106-60-176-82-76-24-162 4-212-54-46-54 6-118-14-178-18-56-104-82-86-150 18-70 112-78 174-108 56-27 74-74 142-86 58-10 92 32 144 18z" />
      </svg>
      <LabCarousel intro />
    </div>
  </section>

  <!-- 5. The wall: photo booth -->
  <Whiteboard />
</Base>

<style>
  /* ---------- Hero (Figma 182:3224) ---------- */
  .hero {
    position: relative;
    min-height: calc(100svh - 120px);
    display: grid; grid-template-columns: minmax(0, 654px) 1fr; align-items: center;
    padding-top: clamp(40px, 5vw, 90px); padding-bottom: clamp(40px, 5vw, 90px);
  }
  .hero__intro { display: flex; flex-direction: column; gap: 32px; }
  .hero__text { display: flex; flex-direction: column; gap: 8px; }
  .hero__title { font-size: var(--fs-h1); font-weight: 500; }
  .hero__sub { font-size: 18px; margin-top: -8px; }
  .hero__body { max-width: 60ch; }
  .hero__sub a { text-underline-offset: 3px; }
  .section-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 32px; }
  .section-head__sub { color: var(--ink-2); max-width: 60ch; margin-top: 4px; }
  .lab-section { overflow-x: clip; }
  .lab-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  /* text buttons: the arrow slides in on hover, pointing where you'll go */
  .cta { display: inline-flex; align-items: center; gap: 0; height: 52px; padding: 0 24px; border-radius: 99px; background: var(--btn); color: #fff; font-weight: 500; font-size: 18px; text-decoration: none; transition: gap .4s var(--ease-spring), padding .4s var(--ease-spring), background-color .3s; }
  .cta--ghost { background: var(--btn2); color: var(--ink); }
  .cta__arrow { display: inline-grid; width: 0; overflow: hidden; opacity: 0; transition: width .4s var(--ease-spring), opacity .25s, transform .4s var(--ease-spring); }
  .cta[data-slide-to-about] .cta__arrow { transform: translateX(-8px); }
  .cta--ghost .cta__arrow { transform: translateY(-8px); }
  .cta:is(:hover, :focus-visible) { gap: 10px; padding-right: 18px; }
  .cta:is(:hover, :focus-visible) .cta__arrow { width: 20px; opacity: 1; transform: none; }
  .cta:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .cta, .cta__arrow { transition: none; } }

  /* ---------- Colleague comments ---------- */
  .quotes { margin: 0; position: relative; height: 100%; min-height: 300px; }
  .quotes__stage { position: absolute; inset: 0; }
  .bubble {
    position: absolute; width: max-content; max-width: min(340px, 92%);
    opacity: 0; transform: scale(.6); transform-origin: 0 0;
    transition: opacity .35s ease, transform .6s var(--ease-spring);
  }
  .bubble.is-on { opacity: 1; transform: scale(1); }
  .bubble.is-off { opacity: 0; transform: scale(.96) translateY(-6px); transition: opacity .4s ease, transform .4s ease; }
  .bubble__cursor { width: 29px; height: 30px; }
  .bubble.is-on .bubble__cursor { animation: nudge 1.6s var(--ease-out) both; }
  .bubble__box {
    display: flex; flex-direction: column; gap: 4px;
    margin: -4px 0 0 18px;
    padding: 12px 26px 12px 20px;
    border: 2.5px solid; border-radius: 2.5px 30px 30px 30px;
    color: #fff;
    filter: drop-shadow(5px 5px 6px rgba(42, 47, 45, .16));
  }
  .bubble__name { font-weight: 500; font-size: 16px; opacity: .9; }
  .bubble__text { position: relative; font-size: 18px; line-height: 1.35; display: grid; }
  .bubble__typed, .bubble__ghost { grid-area: 1 / 1; }
  .bubble__ghost { visibility: hidden; }
  .bubble__typed::after { content: ''; display: inline-block; width: 2px; height: 1.05em; margin-left: 2px; background: currentColor; vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  .bubble--orange .bubble__box { background: var(--orange-text); border-color: #a82a08; }
  .bubble--green .bubble__box { background: var(--sage-text); border-color: var(--sage-deep); }
  .bubble--grey .bubble__box { background: var(--ink-2); border-color: var(--ink); }

  /* positions from Figma (hero 1728 x 494) */
  .bubble--p0 { left: 8%; top: 46%; }
  .bubble--p1 { left: 22%; top: 2%; }
  .bubble--p2 { left: 36%; top: 38%; }

  @keyframes blink { 50% { opacity: 0; } }
  @keyframes nudge { 0% { transform: translate(-14px, -10px); } 100% { transform: none; } }

  /* no JS / reduced motion: show all comments, stacked */
  :global(.no-js) .bubble { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .bubble { opacity: 1; transform: none; }
    .bubble__typed { display: none; }
    .bubble__ghost { visibility: visible; }
  }

  /* ---------- Sections: story first, then the case ---------- */
  /* (wall spacing lives in PhotoBooth) */
  .story, .lab-section { margin-bottom: clamp(110px, 12vw, 200px); }
  .story { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; scroll-margin-top: 120px; }
  .story:focus { outline: none; }
  .story__title { max-width: 22ch; }
  .story__lead { max-width: 54ch; font-size: 20px; }
  .story__more { color: var(--ink-2); font-weight: 500; }
  .story__arrow { display: inline-block; animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(5px); } }


  /* accessibility: a highlighter pass on the certification */
  .cert__mark { color: inherit; background: linear-gradient(transparent 58%, color-mix(in srgb, var(--sage) 32%, transparent) 58%, color-mix(in srgb, var(--sage) 32%, transparent) 92%, transparent 92%) no-repeat 0 0 / 0% 100%; transition: background-size 1s var(--ease-out) .5s; padding: 0 .05em; }
  .cert.is-in .cert__mark { background-size: 100% 100%; }

  /* plot twist: "climber" crossed out by pen, "co-founder" handwritten next to it */
  .plot__old { position: relative; color: var(--ink-2); white-space: nowrap; }
  .plot__old::after { content: ''; position: absolute; left: -4px; right: -4px; top: 52%; height: .08em; background: var(--orange-text); border-radius: 3px; transform: scaleX(0) rotate(-3deg); transform-origin: left; transition: transform .5s cubic-bezier(.6,.1,.3,1) .7s; }
  .plot__new { display: inline-block; font-family: 'Caveat', cursive; font-weight: 500; font-size: 1.3em; line-height: .8; color: var(--orange-text); transform: rotate(-4deg) translateY(.04em); clip-path: inset(-20% 100% -20% 0); transition: clip-path 1.1s cubic-bezier(.45,.05,.4,1) 1.3s; white-space: nowrap; }
  .plot.is-in .plot__old::after { transform: scaleX(1) rotate(-3deg); }
  .plot.is-in .plot__new { clip-path: inset(-20% -5% -20% 0); }

  /* cases */
  .secret-case { margin-top: 12px; width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: #111513; color: #f4f6f5; border-radius: var(--radius-card); overflow: hidden; text-decoration: none; min-height: 380px; text-align: left; }
  .secret-case__text { display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: clamp(28px, 4vw, 64px); }
  .secret-case__tags { font-style: italic; color: #9aa29e; }
  .secret-case__title { font-size: var(--fs-h3); font-weight: 500; line-height: 1.2; }
  .secret-case__sub { color: #c4cac7; max-width: 44ch; }
  .secret-case__cta, .a11y__cta, .ale-card__cta { font-weight: 700; display: inline-flex; align-items: center; gap: 8px; transition: color .3s var(--ease-out); }
  .secret-case__cta :global(.icon), .a11y__cta :global(.icon), .ale-card__cta :global(.icon) { transition: transform .45s var(--ease-spring); }
  /* hover/focus on the whole card: the arrow moves ahead, text and icon change colour */
  .a11y:is(:hover, :focus-visible) .a11y__cta { color: var(--orange-text); }
  .secret-case:is(:hover, :focus-visible) .secret-case__cta, .ale-card:is(:hover, :focus-visible) .ale-card__cta { color: var(--orange); }
  :is(.a11y, .secret-case, .ale-card):is(:hover, :focus-visible) :global(.icon) { transform: translateX(6px); }
  .secret-case__cover { display: block; min-height: 300px; }
  .secret-case:focus-visible, .a11y:focus-visible, .ale-card:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }

  .a11y { margin-top: 12px; width: 100%; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 80px); align-items: center; text-align: left; text-decoration: none; background: var(--surface); border-radius: var(--radius-card); padding: clamp(28px, 4vw, 64px); box-shadow: inset 0 0 0 2px transparent; transition: box-shadow .35s var(--ease-out); }
  .a11y__stat { display: flex; align-items: baseline; gap: .15em; font-weight: 700; letter-spacing: -.04em; line-height: .9; }
  .a11y__from { font-size: clamp(48px, 6vw, 100px); color: var(--line); }
  .a11y__arrow { font-size: clamp(36px, 3.5vw, 64px); color: var(--ink-2); font-weight: 400; }
  .a11y__to { font-size: clamp(88px, 11vw, 190px); color: var(--sage-text); }
  .a11y__text { display: flex; flex-direction: column; gap: 14px; }
  .a11y__title { font-size: var(--fs-h3); font-weight: 500; }

  .ale-card { position: relative; display: block; width: 100%; margin-top: 12px; border-radius: var(--radius-card); overflow: hidden; text-decoration: none; color: #fff; text-align: left; }
  .ale-card img { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; transition: transform .9s var(--ease-out); }
  .ale-card:hover img { transform: scale(1.03); }
  /* dark-to-transparent gradient under the text, so white text always reads (WCAG AA) */
  .ale-card__body { position: absolute; left: 0; right: 0; bottom: 0; padding: 140px 32px 28px; display: flex; flex-direction: column; gap: 12px;
    background: linear-gradient(to top, rgba(12,15,14,.92) 0%, rgba(12,15,14,.78) 40%, rgba(12,15,14,0) 100%); }
  .ale-card__title { font-size: var(--fs-h3); font-weight: 500; }
  .ale-card__body .ale-card__cta { position: absolute; right: 32px; bottom: 28px; }
  .ale-card__body { padding-right: 230px; }
  @media (max-width: 700px) { .ale-card__body { padding-right: 32px; padding-bottom: 72px; } }
  .ale-card__facts { display: flex; flex-wrap: wrap; gap: 8px; font-size: 15px; }
  .ale-card__facts span { background: rgba(12,15,14,.7); border: 1px solid rgba(255,255,255,.35); color: #fff; border-radius: 99px; padding: 5px 12px; }

  /* Lab: tip, pour, spill, cards */
  .lab-section { position: relative; overflow-x: clip; }
  .lab-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; position: relative; z-index: 2; }
  .lab-head__title { display: inline-flex; align-items: baseline; gap: 8px; font-size: var(--fs-h1); font-weight: 500; padding-left: .8em; }
  /* the flask stands on the same "floor" as the word Lab and tips over to the left, never below it */
  .flask { position: relative; display: inline-block; height: .78em; aspect-ratio: 32.5 / 40.5; }
  .flask svg { display: block; width: 100%; height: 100%; overflow: visible; transform-origin: 0% 100%; transition: transform 1.1s cubic-bezier(.45,0,.25,1); }
  .flask__glass { fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .flask__liquid { fill: var(--sage); transition: opacity .3s ease .9s; }
  .flask__drop { position: absolute; left: -124.6%; top: 60%; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50% 50% 50% 0; background: var(--sage); opacity: 0; transform: rotate(-45deg); }
  .lab-stage { position: relative; margin-top: 24px; padding-bottom: 0; }
  .spill { position: absolute; left: 46%; top: -30px; width: min(1240px, 90vw); height: calc(100% + 30px); overflow: visible; transform: translateX(-50%); z-index: 0; clip-path: circle(0% at 42% 6%); transition: clip-path 2.2s cubic-bezier(.2,.6,.2,1) 1.2s; }
  .spill path { fill: color-mix(in srgb, var(--sage) 22%, var(--bg)); }
  .lab-stage :global(.lc) { position: relative; z-index: 1; }
  .lab-section.is-poured .flask svg { transform: rotate(-90deg); }
  .lab-section.is-poured .flask__liquid { opacity: 0; }
  .lab-section.is-poured .flask__drop { animation: drop 1s cubic-bezier(.4,0,.8,.6) .8s 1 both; }
  .lab-section.is-poured .spill { clip-path: circle(150% at 42% 6%); }
  @keyframes drop { 0% { opacity: 1; transform: translate(0, 0) rotate(-45deg) scale(1); } 100% { opacity: 0; transform: translate(-4px, 150px) rotate(-45deg) scale(1.6); } }
  :global(.no-js) .lab-section :global(.lc__card) { opacity: 1; translate: none; }
  :global(.no-js) .spill { clip-path: none; }

  @media (max-width: 900px) {
    .secret-case, .a11y { grid-template-columns: 1fr; }
    .ale-card img { aspect-ratio: 4 / 5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plot__old::after { transform: scaleX(1) rotate(-3deg); transition: none; }
    .plot__new { clip-path: none; transition: none; }
    .story__arrow { animation: none; }
    .cert__mark { background-size: 100% 100%; transition: none; }
    .flask svg, .spill, .lab-section :global(.lc__card) { transition: none !important; }
    .spill { clip-path: none; }
    .lab-section :global(.lc__card) { opacity: 1; translate: none; }
  }

  /* ---------- Work ---------- */
  .work { padding-bottom: clamp(80px, 8vw, 180px); scroll-margin-top: 120px; }
  .work:focus { outline: none; }


  @media (max-width: 1150px) {
    .hero { grid-template-columns: 1fr; gap: 32px; min-height: 0; }
    .quotes { min-height: 190px; }
    .bubble--p0, .bubble--p1, .bubble--p2 { left: 0; top: 0; max-width: min(340px, 88vw); }
  }
  @media (max-width: 1150px) and (prefers-reduced-motion: reduce) {
    .quotes { min-height: 0; }
    .quotes__stage { position: static; display: flex; flex-direction: column; gap: 8px; }
    .bubble { position: static; }
  }
</style>

<script>
  const bubbles = [...document.querySelectorAll('.bubble')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  async function type(el, text) {
    el.textContent = '';
    for (const ch of text) {
      el.textContent += ch;
      await wait(ch === ' ' ? 45 : 32 + Math.random() * 30);
    }
  }

  async function loop() {
    let i = 0;
    let visible = true;
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; });
    while (true) {
      if (!visible) { await wait(500); continue; }
      const b = bubbles[i];
      const typed = b.querySelector('.bubble__typed');
      typed.textContent = '';
      b.classList.remove('is-off');
      b.classList.add('is-on');
      await wait(450);
      await type(typed, b.dataset.quote);
      await wait(2600);
      b.classList.add('is-off');
      await wait(450);
      b.classList.remove('is-on', 'is-off');
      i = (i + 1) % bubbles.length;
    }
  }

  if (bubbles.length && !reduce) loop();

  document.querySelector('[data-slide-to-about]')?.addEventListener('click', () => { try { sessionStorage.setItem('slide', 'left'); } catch {} });

  // Lab: pour once when the section comes into view
  const lab = document.querySelector('[data-lab]');
  if (lab) {
    const pour = () => { lab.classList.add('is-poured'); setTimeout(() => lab.querySelector('[data-lc]')?.dispatchEvent(new CustomEvent('lc:enter')), 1900); };
    if (reduce || !('IntersectionObserver' in window)) { lab.classList.add('is-poured'); lab.querySelector('[data-lc]')?.dispatchEvent(new CustomEvent('lc:enter')); }
    else {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); pour(); } }, { threshold: 0.25 });
      io.observe(lab);
    }
  }

</script>
