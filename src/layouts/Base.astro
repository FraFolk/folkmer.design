---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url.js';
import satoshi from '../fonts/Satoshi-Variable.woff2?url';

const {
  title = 'Francesca Folkmer · Product Designer, Accessibility & AI',
  description = 'Francesca Folkmer, Product Designer in Milan. CPACC-certified in accessibility, I use AI in my design workflow and turn complex services into simple, accessible products.',
  back = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og-image.jpg'), Astro.site).href;
const home = new URL(url('/'), Astro.site).href;
// Structured data: who Francesca is, for search engines and AI answers
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${home}#francesca`,
      name: 'Francesca Folkmer',
      jobTitle: 'Product Designer',
      description: 'Product Designer focused on accessibility and AI. CPACC-certified. Co-founder of Alé, a community app for climbers.',
      url: home,
      image: ogImage,
      sameAs: ['https://www.linkedin.com/in/francescafolkmer/'],
      address: { '@type': 'PostalAddress', addressLocality: 'Milan', addressCountry: 'IT' },
      knowsAbout: ['Product design', 'Digital accessibility', 'WCAG 2.2', 'European Accessibility Act', 'Design systems', 'AI in design', 'UX research'],
      hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'CPACC: Certified Professional in Accessibility Core Competencies', recognizedBy: { '@type': 'Organization', name: 'IAAP' } },
    },
    { '@type': 'WebSite', '@id': `${home}#site`, url: home, name: 'Francesca Folkmer', inLanguage: 'en', publisher: { '@id': `${home}#francesca` } },
  ],
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Francesca Folkmer" />
    <meta property="og:site_name" content="Francesca Folkmer" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Francesca Folkmer, Product Designer: Accessibility and AI, co-founder of Alé. folkmerdesign.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Cloudflare Web Analytics: no cookies, no personal data (see /privacy/). Production only. */}
    {import.meta.env.PROD && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ad7c33f85c244a83af62b488c2ff2c19"}'></script>}
    <meta name="theme-color" content="#fcfcfa" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/favicon-180.png')} />
    <link rel="preload" href={satoshi} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');
      // "About me" from the homepage: the About page slides in from the right
      // and slides back out to the right when you return to the homepage
      const slideType = () => { try { const v = sessionStorage.getItem('slide'); return v ? `slide-${v}` : null; } catch { return null; } };
      addEventListener('pageswap', (e) => { const t = slideType(); if (e.viewTransition && t) e.viewTransition.types.add(t); });
      addEventListener('pagereveal', (e) => {
        const t = slideType(); if (e.viewTransition && t) e.viewTransition.types.add(t);
        try { sessionStorage.removeItem('slide'); } catch {}
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header back={back} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal on scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            // reveal when visible, or when it's already above the viewport (anchor jumps, restored scroll)
            if (e.isIntersecting || e.boundingClientRect.bottom < 0) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // Torch: the lit layer follows the pointer over [data-torch] (or its card)
      document.querySelectorAll('[data-torch]').forEach((el) => {
        const host = el.closest('.card') || el;
        host.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
