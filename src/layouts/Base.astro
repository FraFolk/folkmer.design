---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url.js';
import satoshi from '../fonts/Satoshi-Variable.ttf?url';

const {
  title = 'Francesca Folkmer · Product Designer',
  description = 'Product Designer focused on accessibility and AI. I turn complex services into simple, accessible products.',
  back = false,
} = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fcfcfa" />
    <link rel="icon" href={url('/img/avatar.webp')} />
    <link rel="preload" href={satoshi} as="font" type="font/ttf" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');
      // "About me" from the homepage: the About page slides in from the right
      // and slides back out to the right when you return to the homepage
      const slideType = () => { try { const v = sessionStorage.getItem('slide'); return v ? `slide-${v}` : null; } catch { return null; } };
      addEventListener('pageswap', (e) => { const t = slideType(); if (e.viewTransition && t) e.viewTransition.types.add(t); });
      addEventListener('pagereveal', (e) => {
        const t = slideType(); if (e.viewTransition && t) e.viewTransition.types.add(t);
        try { sessionStorage.removeItem('slide'); } catch {}
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header back={back} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal on scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            // reveal when visible, or when it's already above the viewport (anchor jumps, restored scroll)
            if (e.isIntersecting || e.boundingClientRect.bottom < 0) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // Torch: the lit layer follows the pointer over [data-torch] (or its card)
      document.querySelectorAll('[data-torch]').forEach((el) => {
        const host = el.closest('.card') || el;
        host.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
