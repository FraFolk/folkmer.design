---
// A desktop monitor with a site inside, and an iPhone in front of it (bottom left),
// overlapping the monitor a little without covering the screen. Used for website case studies.
import { url } from '../lib/url.js';
const { desktop, mobile } = Astro.props;
---
<span class="duo" aria-hidden="true">
  <span class="duo__monitor">
    <span class="duo__screen"><img src={url(desktop)} alt="" loading="lazy" /></span>
    <span class="duo__neck"></span>
    <span class="duo__base"></span>
  </span>
  <span class="duo__phone phone-mock">
    <img class="phone-mock__screen" src={url(mobile)} alt="" loading="lazy" />
    <img class="phone-mock__frame" src={url('/img/phone-frame-2.svg')} alt="" />
  </span>
</span>

<style>
  /* same box as the MacBook on the other cards (1600 / 950) */
  .duo { position: relative; display: block; width: 100%; aspect-ratio: 1600 / 950; }
  .duo__monitor { position: absolute; right: 2%; top: 3%; width: 72%; display: flex; flex-direction: column; align-items: center; }
  .duo__screen { display: block; width: 100%; aspect-ratio: 16 / 10; padding: 1.4%; border-radius: var(--radius-m); background: var(--night); box-shadow: 0 16px 40px rgba(18,22,20,.18); overflow: hidden; }
  .duo__screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 4px; }
  .duo__neck { width: 12%; height: 9%; aspect-ratio: 3 / 2; background: linear-gradient(var(--line), var(--ink-faint)); }
  .duo__base { width: 30%; height: 6px; border-radius: var(--radius-pill); background: var(--ink-faint); }
  /* iPhone in front, bottom left: it covers the monitor's bezel corner, not the screen content that matters */
  .duo__phone { position: absolute; left: 8%; bottom: 2%; width: 19%; filter: drop-shadow(0 12px 24px rgba(18,22,20,.25)); }
</style>
