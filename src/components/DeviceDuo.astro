---
// iMac with the site on screen, and an iPhone in front of it, bottom left.
// Both devices are always fully visible. Used for website case studies.
import { url } from '../lib/url.js';
import PhoneBrowser from './PhoneBrowser.astro';
// Optional: `ground` draws a thin line the devices rest on; the `back` slot sits behind them (e.g. a big wordmark).
const { desktop, mobile, ground = false } = Astro.props;
---
<span class={`duo${ground ? ' duo--ground' : ''}`} aria-hidden="true">
  <slot name="back" />
  <span class="duo__imac">
    <img class="duo__body" src={url('/img/imac.webp')} alt="" width="2000" height="1615" loading="lazy" />
    <span class="duo__screen">
      <img src={url(desktop)} alt="" loading="lazy" />
    </span>
  </span>
  <PhoneBrowser src={mobile} class="duo__phone" />
</span>

<style>
  /* same box as the MacBook on the other cards (1600 / 950) */
  .duo { position: relative; display: block; width: 100%; aspect-ratio: 1600 / 950; }
  .duo__imac { position: absolute; right: 4%; top: 2%; height: 96%; aspect-ratio: 2000 / 1615; }
  .duo__body { width: 100%; height: 100%; display: block; }
  .duo__imac { z-index: 1; }
  /* the line everything rests on */
  .duo--ground::after { content: ''; position: absolute; left: -12%; right: -12%; bottom: 3%; height: 1px; background: rgba(255,255,255,.32); }
  /* the iMac screen area, measured on the mockup (2000 x 1615) */
  .duo__screen { position: absolute; left: 13.4%; top: 2.85%; width: 84.2%; height: 58.5%; display: flex; flex-direction: column; overflow: hidden; background: var(--white); container-type: inline-size; }
  .duo__screen img { flex: 1; min-height: 0; width: 100%; object-fit: cover; object-position: top; display: block; }
  .duo :global(.duo__phone) { position: absolute; left: 19%; bottom: 3%; z-index: 1; height: 62%; width: auto; filter: drop-shadow(0 12px 24px rgba(18,22,20,.25)); }
</style>
