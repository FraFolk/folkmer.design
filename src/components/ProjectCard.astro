---
import { url } from '../lib/url.js';
import Cover from './Cover.astro';
const { project, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
---
<article class="card reveal">
  <div class="card__media">
    {project.cover
      ? <Cover kind={project.cover} />
      : <img src={url(project.image)} alt={project.alt} loading="lazy" width="662" height="395" />}
  </div>
  <div class="card__body">
    <p class="card__tags">{project.tags.join(' · ')}</p>
    <H class="card__title">
      <a href={url(project.href || `/work/${project.slug}/`)} class="card__link">{project.title}</a>
    </H>
    <p class="card__summary">{project.summary}</p>
  </div>
  <span class="card__arrow" aria-hidden="true">
    <img class="card__arrow-default" src={url('/img/card-arrow.svg')} alt="" width="50" height="50" />
    <img class="card__arrow-hover" src={url('/img/card-arrow-hover.svg')} alt="" width="50" height="50" />
  </span>
</article>

<style>
  /* Figma: Project card Default -> HOVER */
  .card {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 662fr) minmax(0, 522fr);
    gap: 40px; align-items: center;
    padding: 32px;
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 0 2px transparent;
    transition: box-shadow .35s var(--ease-out), transform .5s var(--ease-out);
  }
  .card:hover { box-shadow: inset 0 0 0 2px var(--line); }
  .card:has(.card__link:focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; }
  .card__media { border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 662 / 395; background: var(--surface-2); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .card:hover .card__media img { transform: scale(1.035); }
  .card__body { display: flex; flex-direction: column; gap: 16px; padding-right: 48px; }
  .card__tags { font-style: italic; }
  .card__title { font-size: var(--fs-h3); font-weight: 500; margin-top: -12px; }
  .card__link { text-decoration: none; }
  .card__link:focus-visible { outline: none; }
  /* whole card clickable */
  .card__link::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-card); z-index: 1; }

  .card__arrow {
    position: absolute; top: 20px; right: 20px;
    width: 90px; height: 90px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff;
    transition: background-color .35s var(--ease-out), transform .5s var(--ease-spring);
  }
  .card__arrow img { grid-area: 1 / 1; width: 50px; height: 50px; transition: opacity .25s ease, transform .5s var(--ease-spring); }
  .card__arrow-hover { opacity: 0; }
  .card:hover .card__arrow { background: var(--orange); transform: scale(1.06); }
  .card:hover .card__arrow img { transform: translate(3px, -3px); }
  .card:hover .card__arrow-hover { opacity: 1; }
  .card:hover .card__arrow-default { opacity: 0; }

  @media (max-width: 900px) {
    .card { grid-template-columns: 1fr; padding: 16px 16px 28px; gap: 24px; border-radius: var(--radius-card); }
    .card__link::after { border-radius: var(--radius-card); }
    .card__media { border-radius: var(--radius-l); }
    .card__body { padding: 0 8px; }
    .card__arrow { width: 60px; height: 60px; top: 28px; right: 28px; }
    .card__arrow img { width: 34px; height: 34px; }
  }
</style>
