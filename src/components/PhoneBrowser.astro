---
// An iPhone with a web page inside Safari: status bar, address bar, then the page (top-aligned).
import { url } from '../lib/url.js';
const { src, alt = '', domain = 'studiodentisticopieri.com', class: cls = '' } = Astro.props;
---
<span class={`phone-mock ${cls}`}>
  <span class="phone-mock__screen pb">
    <span class="pb__status" aria-hidden="true"><b>9:41</b></span>
    <span class="pb__bar" aria-hidden="true"><span class="pb__url"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>{domain}</span></span>
    <img class="pb__page" src={url(src)} alt={alt} loading="lazy" />
  </span>
  <img class="phone-mock__frame" src={url('/img/phone-frame-2.svg')} alt="" />
</span>

<style>
  .pb { display: flex; flex-direction: column; overflow: hidden; background: var(--white); container-type: inline-size; }
  .pb__status { flex: none; height: 13cqw; padding: 0 9cqw; display: flex; align-items: flex-end; padding-bottom: 1.5cqw; font-size: 4.2cqw; color: var(--ink); }
  .pb__bar { flex: none; padding: 1.5cqw 4cqw 2.5cqw; background: var(--white); border-bottom: 1px solid var(--line); }
  .pb__url { display: flex; align-items: center; justify-content: center; gap: 1.5cqw; height: 9cqw; border-radius: 3cqw; background: var(--surface-2); font-size: 3.6cqw; color: var(--ink); }
  .pb__page { flex: 1; min-height: 0; width: 100%; object-fit: cover; object-position: top; display: block; }
</style>
