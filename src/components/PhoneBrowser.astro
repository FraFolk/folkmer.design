---
// An iPhone with a web page: the status bar with the time, then the page (top-aligned).
import { url } from '../lib/url.js';
const { src, alt = '', class: cls = '' } = Astro.props;
---
<span class={`phone-mock ${cls}`}>
  <span class="phone-mock__screen pb">
    <span class="pb__status" aria-hidden="true"><b>9:41</b></span>
    <img class="pb__page" src={url(src)} alt={alt} loading="lazy" />
  </span>
  <img class="phone-mock__frame" src={url('/img/iphone-15-pro.webp')} alt="" />
</span>

<style>
  .pb { display: flex; flex-direction: column; overflow: hidden; background: var(--white); container-type: inline-size; }
  .pb__status { flex: none; height: 12cqw; padding: 0 10cqw 1.5cqw; display: flex; align-items: center; font-size: 4.2cqw; color: var(--ink); }
  .pb__page { flex: 1; min-height: 0; width: 100%; object-fit: cover; object-position: top; display: block; }
</style>
