---
// The wall: click the Polaroid, take a selfie (3, 2, 1), the photo slides out of the camera
// and you write your hello on it. For now everything stays in your browser: nothing is uploaded.
// Later: photos go to a moderated wall (Francesca approves each one; visitors can remove theirs).
import { url } from '../lib/url.js';
---
<section class="wall container" aria-labelledby="wall-title">
  <h2 id="wall-title" class="h2 wall__title">You scrolled all the way down.<br />Most people don't.</h2>
  <p class="wall__sub">So leave your mark: snap a polaroid and write your hello.</p>

  <div class="wall__stage">
    <div class="snap snap--left" aria-hidden="true">
      <div class="snap__photo"><img src={url('/img/avatar.png')} alt="" /></div>
      <p class="snap__caption">Ciao da Fra</p>
    </div>

    <div class="booth" data-booth>
      <button type="button" class="booth__cam" data-booth-open aria-haspopup="dialog">
        <img src={url('/img/polaroid-camera.png')} alt="" width="358" height="288" />
        <span class="sr-only">Open the photo booth</span>
      </button>
      <div class="booth__slot">
        <div class="snap snap--out" data-booth-out hidden>
          <div class="snap__photo"><img data-booth-photo alt="Your selfie" /></div>
          <label class="sr-only" for="booth-caption">Write your hello</label>
          <input id="booth-caption" class="snap__caption snap__caption--edit" type="text" maxlength="28" placeholder="write your hello" autocomplete="off" />
        </div>
      </div>
      <p class="booth__hint" data-booth-hint>Click the camera</p>
      <div class="booth__after" data-booth-after hidden>
        <p>Only you can see this for now. When the wall opens, I'll approve every polaroid before it goes up, and you'll be able to remove yours any time.</p>
        <div class="booth__after-actions">
          <button type="button" class="booth__link" data-booth-retake>Retake</button>
          <button type="button" class="booth__link" data-booth-remove>Remove it</button>
        </div>
      </div>
    </div>

    <div class="snap snap--right" aria-hidden="true">
      <div class="snap__photo"></div>
      <p class="snap__caption snap__caption--ghost">your hello here</p>
    </div>
  </div>

  <dialog class="booth-modal" data-booth-modal aria-labelledby="booth-title">
    <div class="booth-modal__bar">
      <p id="booth-title" class="booth-modal__title"><img src={url('/img/polaroid-camera.png')} alt="" width="22" height="18" /> Photo booth</p>
      <button type="button" class="booth-modal__close" data-booth-close aria-label="Close the photo booth">×</button>
    </div>
    <div class="booth-modal__view">
      <video data-booth-video playsinline muted></video>
      <p class="booth-modal__msg" data-booth-msg></p>
      <div class="booth-modal__flash" data-booth-flash></div>
    </div>
    <div class="booth-modal__foot">
      <button type="button" class="booth-modal__shutter" data-booth-shoot aria-label="Take the photo (3 second countdown)"></button>
      <ol class="booth-modal__count" data-booth-count hidden aria-hidden="true"><li>3</li><li>2</li><li>1</li><li class="smile">☺</li></ol>
    </div>
    <p class="sr-only" aria-live="assertive" data-booth-live></p>
  </dialog>
</section>

<style>
  .wall { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin-bottom: clamp(110px, 12vw, 200px); }
  .wall__sub { color: var(--ink-2); max-width: 50ch; }
  .wall__stage { margin-top: 40px; display: flex; justify-content: center; align-items: flex-start; gap: clamp(16px, 4vw, 64px); }

  /* Polaroid, FigJam-like: white frame, soft corners, handwritten caption */
  .snap { width: 200px; background: #fff; border-radius: 8px; padding: 12px 12px 0; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 14px 30px -16px rgba(0,0,0,.35); }
  .snap__photo { aspect-ratio: 1; background: #121614; border-radius: 3px; overflow: hidden; }
  .snap__photo img { width: 100%; height: 100%; object-fit: cover; }
  .snap__caption { font: 500 26px/1 'Caveat', cursive; color: var(--ink); padding: 14px 4px 16px; text-align: center; }
  .snap__caption--ghost { color: #b4bab7; }
  .snap--left { transform: rotate(-6deg); margin-top: 70px; }
  .snap--right { transform: rotate(5deg); margin-top: 90px; }

  .booth { position: relative; width: 260px; display: flex; flex-direction: column; align-items: center; }
  .booth__cam { position: relative; z-index: 2; width: 100%; border: 0; padding: 0; background: none; cursor: pointer; transition: transform .45s var(--ease-spring); }
  .booth__cam img { width: 100%; height: auto; display: block; filter: drop-shadow(0 18px 22px rgba(0,0,0,.22)); }
  .booth__cam:hover { transform: translateY(-4px) rotate(-1.5deg); }
  .booth__cam:focus-visible { outline: 3px solid var(--focus); outline-offset: 6px; border-radius: 16px; }
  /* the photo comes out of the slot (about 84% down the camera) */
  .booth__slot { position: relative; z-index: 1; width: 78%; margin-top: -17%; overflow: hidden; padding: 0 12px 24px; }
  .snap--out { width: 100%; transform: translateY(-105%); }
  .snap--out.is-out { animation: eject 1.6s cubic-bezier(.3,.1,.2,1) forwards; }
  @keyframes eject { 0% { transform: translateY(-105%); } 70% { transform: translateY(4%); } 100% { transform: translateY(0) rotate(-1deg); } }
  .snap__caption--edit { width: 100%; border: 0; background: transparent; outline: none; border-bottom: 2px dashed transparent; }
  .snap__caption--edit::placeholder { color: #b4bab7; }
  .snap__caption--edit:focus-visible { border-bottom-color: var(--orange); }
  .booth__hint { margin-top: 18px; font: 500 24px/1 'Caveat', cursive; color: var(--orange-text); }
  .booth__after { max-width: 34ch; font-size: 15px; color: var(--ink-2); display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .booth__after-actions { display: flex; gap: 18px; }
  .booth__link { font: 700 15px/1 'Satoshi', sans-serif; background: none; border: 0; padding: 8px 4px; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* the modal */
  .booth-modal { width: min(440px, 92vw); padding: 0; border: 0; border-radius: 18px; overflow: hidden; background: #fff; box-shadow: 0 30px 80px -20px rgba(0,0,0,.5); }
  .booth-modal::backdrop { background: rgba(18,22,20,.55); backdrop-filter: blur(4px); }
  .booth-modal__bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px 10px 16px; }
  .booth-modal__title { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 15px; }
  .booth-modal__close { width: 40px; height: 40px; border: 0; background: none; font-size: 26px; line-height: 1; cursor: pointer; border-radius: 50%; color: var(--ink); }
  .booth-modal__close:hover { background: var(--surface); }
  .booth-modal__view { position: relative; aspect-ratio: 1; background: #000; }
  .booth-modal__view video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
  .booth-modal__msg { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; color: #f4f6f5; font-size: 16px; text-align: center; }
  .booth-modal__msg:empty { display: none; }
  .booth-modal__flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .booth-modal__flash.is-on { animation: flash .5s ease-out; }
  @keyframes flash { 0% { opacity: 1; } 100% { opacity: 0; } }
  .booth-modal__foot { height: 84px; background: #2a2f2d; display: grid; place-items: center; }
  .booth-modal__shutter { width: 56px; height: 56px; border-radius: 50%; border: 4px solid #8b938f; background: #f4f6f5; cursor: pointer; transition: transform .3s var(--ease-spring); }
  .booth-modal__shutter:hover { transform: scale(1.06); }
  .booth-modal__shutter:focus-visible, .booth-modal__close:focus-visible, .booth__link:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .booth-modal__count { list-style: none; margin: 0; padding: 0; display: flex; gap: 22px; align-items: center; color: #6c7470; font-size: 22px; font-weight: 500; }
  .booth-modal__count li.is-on { color: #f4f6f5; }
  .booth-modal__count .smile { width: 34px; height: 34px; border-radius: 50%; background: #3a423e; color: #fff; display: grid; place-items: center; font-size: 22px; }
  .booth-modal__count .smile.is-on { background: #e8312a; }
  [hidden] { display: none !important; }

  @media (max-width: 760px) {
    .snap--left, .snap--right { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .snap--out.is-out { animation: none; transform: none; }
    .booth__cam { transition: none; }
  }
</style>

<script>
  const booth = document.querySelector('[data-booth]');
  const modal = document.querySelector('[data-booth-modal]');
  if (booth && modal) {
    const openBtn = booth.querySelector('[data-booth-open]');
    const out = booth.querySelector('[data-booth-out]');
    const photo = booth.querySelector('[data-booth-photo]');
    const caption = booth.querySelector('#booth-caption');
    const hint = booth.querySelector('[data-booth-hint]');
    const after = booth.querySelector('[data-booth-after]');
    const video = modal.querySelector('[data-booth-video]');
    const msg = modal.querySelector('[data-booth-msg]');
    const flash = modal.querySelector('[data-booth-flash]');
    const shoot = modal.querySelector('[data-booth-shoot]');
    const count = modal.querySelector('[data-booth-count]');
    const live = modal.querySelector('[data-booth-live]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let stream = null;
    let busy = false;

    const stop = () => { stream?.getTracks().forEach((t) => t.stop()); stream = null; video.srcObject = null; };
    const open = async () => {
      msg.textContent = '';
      shoot.hidden = false; count.hidden = true;
      modal.showModal();
      shoot.focus();
      if (!navigator.mediaDevices?.getUserMedia) { msg.textContent = "Your browser can't use the camera here. Try another one?"; shoot.hidden = true; return; }
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 720 } }, audio: false });
        video.srcObject = stream; await video.play();
      } catch {
        msg.textContent = "No camera, no problem: maybe next time. (You can allow it from your browser's address bar.)";
        shoot.hidden = true;
      }
    };
    const close = () => { stop(); if (modal.open) modal.close(); };
    modal.addEventListener('close', stop);
    modal.querySelector('[data-booth-close]').addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    openBtn.addEventListener('click', open);

    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    shoot.addEventListener('click', async () => {
      if (busy || !stream) return;
      busy = true;
      shoot.hidden = true; count.hidden = false;
      const items = [...count.children];
      for (let i = 0; i < items.length; i++) {
        items.forEach((li, k) => li.classList.toggle('is-on', k === i));
        if (i < 3) live.textContent = String(3 - i);
        await wait(i < 3 ? 800 : 350);
      }
      // capture a square, mirrored like the preview
      const s = Math.min(video.videoWidth, video.videoHeight);
      const c = document.createElement('canvas'); c.width = c.height = 600;
      const ctx = c.getContext('2d');
      ctx.translate(600, 0); ctx.scale(-1, 1);
      ctx.drawImage(video, (video.videoWidth - s) / 2, (video.videoHeight - s) / 2, s, s, 0, 0, 600, 600);
      if (!reduce) { flash.classList.remove('is-on'); void flash.offsetWidth; flash.classList.add('is-on'); }
      photo.src = c.toDataURL('image/jpeg', 0.85);
      live.textContent = 'Photo taken. It is coming out of the camera.';
      await wait(reduce ? 0 : 450);
      close();
      busy = false;
      items.forEach((li) => li.classList.remove('is-on'));
      // eject
      out.hidden = false; hint.hidden = true;
      out.classList.remove('is-out'); void out.offsetWidth; out.classList.add('is-out');
      await wait(reduce ? 0 : 1500);
      after.hidden = false;
      caption.focus({ preventScroll: true });
    });

    booth.querySelector('[data-booth-retake]').addEventListener('click', open);
    booth.querySelector('[data-booth-remove]').addEventListener('click', () => {
      photo.removeAttribute('src'); caption.value = '';
      out.hidden = true; out.classList.remove('is-out'); after.hidden = true; hint.hidden = false;
      openBtn.focus();
    });
  }
</script>
