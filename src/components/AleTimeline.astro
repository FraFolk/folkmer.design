---
// Alé, told on a timeline: drag the ruler (mouse), swipe (touch) or use the arrow keys
// to travel from the first idea (July 2025) to the launch (December 2026).
import { url } from '../lib/url.js';

// month index: 0 = July 2025 … 17 = December 2026
const milestones = [
  { m: 0, kind: 'idea', title: 'Why is finding the perfect spot so hard?', hand: "Let's make an app", caption: 'First day' },
  { m: 2, kind: 'research', title: 'First, we listened.', text: 'A survey with climbers and long chats at the crag. The problem was real: information is scattered and out of date.' },
  { m: 6, kind: 'design', title: 'Back on it, screen by screen.', text: 'From personas and journeys to the full app, tested with climbers along the way.' },
  { m: 15, kind: 'now', title: 'Building it. And finding partners.', text: 'Development is almost done. We are talking with the main climbing events for 2027.' },
  { m: 17, kind: 'launch', title: 'Out on the stores.', hand: 'See you at the crag' },
];
const MONTHS = 18;
const label = (m) => new Date(2025, 6 + m, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---
<div class="atl" data-atl data-months={MONTHS}>
  <div class="atl__stage" aria-live="polite">
    {milestones.map((ms, i) => (
      <div class={`atl__scene atl__scene--${ms.kind}`} data-scene={ms.m} hidden={i !== 0}>
        <div class="atl__copy">
          <p class="atl__title">{ms.title}</p>
          {ms.hand && <p class="atl__hand">{ms.hand}</p>}
          {ms.text && <p class="atl__text">{ms.text}</p>}
        </div>
        <div class="atl__visual" aria-hidden="true">
          {ms.kind === 'idea' && (
            <div class="atl__polas">
              <figure class="pola pola--a"><img src={url('/img/tl-marta.webp')} alt="" /><figcaption>Marta</figcaption></figure>
              <figure class="pola pola--b"><img src={url('/img/tl-francesca.webp')} alt="" /><figcaption>Francesca</figcaption></figure>
              <p class="atl__caption">{ms.caption}</p>
            </div>
          )}
          {ms.kind === 'research' && (
            <div class="atl__stats"><p><b>50+</b>climbers surveyed</p><p><b>5</b>in-depth interviews</p></div>
          )}
          {ms.kind === 'design' && (
            <div class="atl__phones">
              <img src={url('/img/ale-s-home.webp')} alt="" />
              <img src={url('/img/ale-s-spot.webp')} alt="" />
            </div>
          )}
          {ms.kind === 'now' && (
            <div class="atl__phones"><img src={url('/img/ale-s-event.webp')} alt="" /></div>
          )}
          {ms.kind === 'launch' && (
            <div class="atl__stats"><p><b>Dec</b>2026</p></div>
          )}
        </div>
      </div>
    ))}
    <p class="sr-only">Use the left and right arrow keys on the timeline to move through the months.</p>
  </div>

  <p class="atl__month" data-atl-month aria-hidden="true">{label(0)}</p>
  <div class="atl__ruler" data-atl-ruler role="slider" tabindex="0"
    aria-label="Alé timeline" aria-valuemin="0" aria-valuemax={MONTHS - 1} aria-valuenow="0" aria-valuetext={label(0)}>
    <div class="atl__ticks" data-atl-ticks style={`--months:${MONTHS}`}>
      {milestones.map((ms) => <span class="atl__mark" style={`--m:${ms.m}`}></span>)}
    </div>
    <span class="atl__needle" aria-hidden="true"></span>
  </div>
</div>

<style>
  .atl {
    --month: 96px; position: relative; height: 100%; min-height: 420px; overflow: hidden; border-radius: inherit;
    background: linear-gradient(65deg, #1a1c19 4%, #373a39 84%); color: #fff;
    display: flex; flex-direction: column; user-select: none;
  }
  .atl__stage { position: relative; flex: 1; min-height: 0; }
  .atl__scene { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 32px; padding: 32px 8% 16px; animation: scene-in 200ms ease-out; }
  .atl__scene[hidden] { display: none; }
  @keyframes scene-in { from { opacity: 0; transform: translateY(6px); } }
  .atl__copy { display: flex; flex-direction: column; gap: 12px; max-width: 26ch; justify-self: end; }
  .atl__title { font-size: var(--fs-h3); font-weight: 500; line-height: 1.25; }
  .atl__hand { font: 500 calc(var(--fs-h3) * 1.25)/1 'Caveat', cursive; color: #fff; }
  .atl__text { color: var(--night-soft); font-size: var(--fs-small); }
  .atl__visual { display: flex; align-items: center; justify-content: flex-start; min-height: 0; }

  .atl__polas { position: relative; width: 300px; height: 230px; }
  .pola { position: absolute; margin: 0; width: 150px; padding: 7px 7px 4px; background: #fff; border-radius: 3px; box-shadow: 0 2px 10px rgba(0,0,0,.35); }
  .pola img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .pola figcaption { font: 500 15px/1.4 'Caveat', cursive; color: #1e1e1e; text-align: center; padding-top: 2px; }
  .pola--a { left: 0; top: 50px; transform: rotate(-5deg); }
  .pola--b { left: 128px; top: 0; transform: rotate(5.5deg); }
  .atl__caption { position: absolute; left: 220px; top: 196px; font-size: var(--fs-small); }

  .atl__stats { display: flex; gap: 32px; }
  .atl__stats p { display: flex; flex-direction: column; color: var(--night-soft); font-size: var(--fs-small); }
  .atl__stats b { font-size: var(--fs-display); font-weight: 500; line-height: 1; color: #fff; }
  .atl__phones { display: flex; gap: 16px; }
  .atl__phones img { height: clamp(180px, 20vw, 270px); width: auto; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,.4); }

  .atl__month { text-align: center; font-size: var(--fs-body); font-weight: 500; margin-bottom: 12px; }
  .atl__ruler { position: relative; height: 56px; cursor: grab; touch-action: pan-y; outline: none; }
  .atl__ruler:active { cursor: grabbing; }
  .atl__ruler:focus-visible { box-shadow: inset 0 0 0 3px #fff; }
  .atl__ticks {
    --pad: 8; /* months of ruler shown before July 2025 and after December 2026 */
    position: absolute; left: calc(50% - var(--pad) * var(--month)); bottom: 0; height: 100%; width: calc((var(--months) + var(--pad) * 2) * var(--month));
    background:
      repeating-linear-gradient(to right, rgba(255,255,255,.95) 0 2px, transparent 2px var(--month)) left bottom / 100% 100% no-repeat,
      repeating-linear-gradient(to right, rgba(255,255,255,.45) 0 1px, transparent 1px calc(var(--month) / 4)) left bottom / 100% 60% no-repeat;
    transform: translateX(calc(var(--pos, 0) * var(--month) * -1));
    transition: transform 300ms cubic-bezier(.16, 1, .3, 1);
  }
  .atl__ticks.is-dragging { transition: none; }
  .atl__mark { position: absolute; bottom: 0; left: calc((var(--m) + var(--pad)) * var(--month)); width: 2px; height: 100%; background: var(--orange); opacity: .55; }
  .atl__needle { position: absolute; left: 50%; bottom: 0; width: 3px; height: 100%; margin-left: -1px; background: var(--orange); border-radius: 2px; }

  @media (max-width: 760px) {
    .atl { --month: 72px; min-height: 520px; }
    .atl__scene { grid-template-columns: 1fr; align-content: center; text-align: left; padding: 24px 24px 8px; gap: 16px; }
    .atl__copy { justify-self: start; }
    .atl__polas { transform: scale(.8); transform-origin: left top; height: 190px; }
    .atl__phones img { height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) { .atl__ticks, .atl__scene { transition: none; animation: none; } }
</style>

<script>
  for (const root of document.querySelectorAll('[data-atl]')) {
    const months = Number(root.dataset.months);
    const ruler = root.querySelector('[data-atl-ruler]');
    const ticks = root.querySelector('[data-atl-ticks]');
    const monthEl = root.querySelector('[data-atl-month]');
    const scenes = [...root.querySelectorAll('[data-scene]')];
    const stops = scenes.map((s) => Number(s.dataset.scene));
    const monthW = () => parseFloat(getComputedStyle(root).getPropertyValue('--month')) || 96;
    const label = (m) => new Date(2025, 6 + Math.round(m), 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    let pos = 0;

    const render = () => {
      ticks.style.setProperty('--pos', pos);
      monthEl.textContent = label(pos);
      // the scene of the latest milestone reached
      let k = 0; stops.forEach((m, i) => { if (pos + 0.5 >= m) k = i; });
      scenes.forEach((s, i) => { s.hidden = i !== k; });
      ruler.setAttribute('aria-valuenow', String(Math.round(pos)));
      ruler.setAttribute('aria-valuetext', `${label(pos)}: ${scenes[k].querySelector('.atl__title').textContent}`);
    };
    const clamp = (v) => Math.max(0, Math.min(months - 1, v));
    const snap = () => { pos = stops.reduce((a, b) => (Math.abs(b - pos) < Math.abs(a - pos) ? b : a)); render(); };

    // drag (mouse) and swipe (touch): the ruler follows the finger, then snaps to the nearest milestone
    let startX = null, startPos = 0;
    const down = (x) => { startX = x; startPos = pos; ticks.classList.add('is-dragging'); };
    const move = (x) => { if (startX === null) return; pos = clamp(startPos - (x - startX) / monthW()); render(); };
    const up = () => { if (startX === null) return; startX = null; ticks.classList.remove('is-dragging'); snap(); };
    ruler.addEventListener('pointerdown', (e) => { ruler.setPointerCapture(e.pointerId); down(e.clientX); });
    ruler.addEventListener('pointermove', (e) => move(e.clientX));
    ruler.addEventListener('pointerup', up);
    ruler.addEventListener('pointercancel', up);
    // swiping on the story itself also moves through time
    let sx = null;
    const stage = root.querySelector('.atl__stage');
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (sx === null) return; const dx = e.changedTouches[0].clientX - sx; sx = null;
      if (Math.abs(dx) < 40) return;
      const i = stops.findIndex((m) => m === pos);
      pos = stops[Math.max(0, Math.min(stops.length - 1, (i < 0 ? 0 : i) + (dx < 0 ? 1 : -1)))]; render();
    });
    // keyboard: arrows move one month, Home/End jump to the ends
    ruler.addEventListener('keydown', (e) => {
      const map = { ArrowRight: 1, ArrowLeft: -1, ArrowUp: 1, ArrowDown: -1 };
      if (e.key in map) { pos = clamp(Math.round(pos) + map[e.key]); render(); e.preventDefault(); }
      if (e.key === 'Home') { pos = 0; render(); e.preventDefault(); }
      if (e.key === 'End') { pos = months - 1; render(); e.preventDefault(); }
    });
    render();
  }
</script>
