---
// "My setup": Francesca's real desktop (leaves wallpaper) with a working dock.
// Pick an app (hover, click or keyboard) and a note explains how it fits in her work.
import { url } from '../lib/url.js';

const apps = [
  { id: 'claude', name: 'Claude', icon: 'app-claude.webp',
    note: 'My thinking partner. Research, synthesis, writing, and turning ideas into working prototypes in code. I decide, it speeds me up.' },
  { id: 'wispr', name: 'Wispr Flow', icon: 'app-wispr.webp',
    note: 'I talk, it types. My test: 48 words per minute typing, 200 dictating. My keyboard is a bit jealous.' },
  { id: 'figma', name: 'Figma', icon: 'app-figma.webp', unsure: true,
    note: 'Still my home for classic UI work, but I open it less every month. Will it stay in the dock? Ask me in a year.' },
  { id: 'chrome', name: 'Google Chrome', icon: 'app-chrome.webp',
    note: 'Where everything gets tested: prototypes, accessibility checks, screen readers and keyboard-only runs.' },
  { id: 'spotify', name: 'Spotify', spotify: true,
    note: 'The soundtrack of every work session.' },
];
---
<section class="setup" aria-labelledby="setup-title" data-setup>

  <div class="setup__mac reveal">
  <img class="setup__laptop" src={url('/img/macbook.webp')} alt="" width="1600" height="950" loading="lazy" />
  <div class="setup__screen">
    <img class="setup__wall" src={url('/img/setup-wallpaper.webp')} alt="" loading="lazy" />
    <span class="setup__notch" aria-hidden="true"></span>
    <ul class="setup__dock" data-setup-dock aria-label="Apps in my dock">
      {apps.map((a, i) => (
        <li class="setup__item">
          <button type="button" class="setup__app" aria-pressed={i === 0 ? 'true' : 'false'}
            data-name={a.name} data-note={a.note}>
            {a.icon
              ? <img src={url(`/img/${a.icon}`)} alt="" width="64" height="64" />
              : <span class="setup__spotify" aria-hidden="true" style={`--logo:url(${url('/img/icon-spotify.svg')})`}></span>}
            {a.unsure && <span class="setup__q" aria-hidden="true">?</span>}
            <span class="sr-only">{a.name}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
  </div>
  <div class="setup__head reveal">
    <h2 id="setup-title" class="h2">My setup</h2>
    <p>The desktop I work on every day. Pick an app to see how I use it.</p>
    <div class="setup__note" aria-live="polite" data-setup-note>
      <p class="setup__note-app" data-setup-name>{apps[0].name}</p>
      <p data-setup-text>{apps[0].note}</p>
    </div>
  </div>
</section>

<style>
  .setup { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .setup__head { display: flex; flex-direction: column; gap: 8px; }
  .setup__head p { color: var(--ink-2); }
  .setup__mac { position: relative; }
  .setup__laptop { width: 100%; height: auto; display: block; }
  /* the screen area of the MacBook mockup (measured on the image) */
  .setup__screen { position: absolute; left: 34.1%; top: 2.32%; width: 56.9%; height: 62.2%; overflow: hidden; border-radius: 6px 6px 0 0; container-type: inline-size; }
  .setup__notch { position: absolute; top: 0; left: 50%; width: 11%; height: 4%; transform: translateX(-50%); background: #050505; border-radius: 0 0 6px 6px; z-index: 3; }
  .setup__wall { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* the note: a scrap of paper in the middle of the desktop */
  .setup__note {
    touch-action: pan-y;
    position: relative; margin-top: 16px; max-width: 380px;
    transform: rotate(-1.5deg);
    background: var(--paper); color: var(--ink);
    padding: 24px 24px 24px; border-radius: 3px; font-size: var(--fs-small); line-height: 1.5;
    box-shadow: 0 2px 4px rgba(0,0,0,.12), 0 22px 40px -22px rgba(0,0,0,.45);
    animation: note-in var(--dur-slow) var(--ease-out);
  }
  .setup__note::before { content: ''; position: absolute; top: -12px; left: 50%; width: 90px; height: 24px; margin-left: -45px; background: rgba(233,239,236,.9); transform: rotate(3deg); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .setup__note-app { font: 500 var(--fs-h3)/1 'Caveat', cursive; color: var(--orange-text); margin-bottom: 8px; }
  @keyframes note-in { from { opacity: 0; transform: translateY(6px) rotate(-3deg); } }

  .setup__dock {
    position: absolute; left: 50%; bottom: 4%; transform: translateX(-50%);
    list-style: none; margin: 0; padding: 1cqw 1.2cqw;
    display: flex; align-items: flex-end; gap: 1cqw;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 2.6cqw;
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  /* magnification changes the size (not a transform), so neighbours make room instead of overlapping */
  .setup__app {
    --s: 7.5cqw;
    position: relative; width: var(--s); height: var(--s); border: 0; padding: 0; cursor: pointer;
    background: none; display: block;
    transition: width var(--dur-fast) ease-out, height var(--dur-fast) ease-out;
  }
  .setup__app img { width: 100%; height: 100%; display: block; filter: drop-shadow(0 4px 6px rgba(0,0,0,.3)); }
  .setup__spotify { display: block; width: 84%; height: 84%; margin: 8%; border-radius: 22%; background: #121212; position: relative; box-shadow: 0 4px 8px -2px rgba(0,0,0,.4); }
  .setup__spotify::after { content: ''; position: absolute; inset: 16%; background: #1ed760; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .setup__app[aria-pressed='true']::after { content: ''; position: absolute; bottom: -6px; left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: var(--white); }
  .setup__app:focus-visible { outline: 3px solid var(--white); outline-offset: 3px; border-radius: var(--radius-m); }
  .setup__q {
    position: absolute; top: -1cqw; right: -1cqw; width: 3cqw; height: 3cqw; border-radius: 50%;
    background: var(--orange); color: var(--white); font-weight: 600; font-size: 2cqw; display: grid; place-items: center;
  }

  @media (max-width: 900px) {
    .setup { grid-template-columns: 1fr; }
    .setup__head { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .setup__note { animation: none; } .setup__app { transition: none; } }
</style>

<script>
  for (const root of document.querySelectorAll('[data-setup]')) {
    const dock = root.querySelector('[data-setup-dock]');
    const btns = [...root.querySelectorAll('.setup__app')];
    const note = root.querySelector('[data-setup-note]');
    const name = root.querySelector('[data-setup-name]');
    const text = root.querySelector('[data-setup-text]');
    // the note always has the height of the longest text, so the title never moves
    const fitNote = () => {
      const cur = text.textContent, curName = name.textContent;
      note.style.minHeight = '';
      let max = 0;
      btns.forEach((b) => { name.textContent = b.dataset.name; text.textContent = b.dataset.note; max = Math.max(max, note.offsetHeight); });
      name.textContent = curName; text.textContent = cur;
      note.style.minHeight = `${max}px`;
    };
    document.fonts?.ready.then(fitNote); addEventListener('resize', fitNote); fitNote();
    // touch: swipe sideways on the note (or the screen) to move to the next/previous app
    let tx = null;
    const swipeArea = [note, root.querySelector('.setup__screen')];
    swipeArea.forEach((el) => {
      el.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
      el.addEventListener('touchend', (e) => {
        if (tx === null) return;
        const dx = e.changedTouches[0].clientX - tx; tx = null;
        if (Math.abs(dx) < 40) return;
        const i = btns.findIndex((b) => b.getAttribute('aria-pressed') === 'true');
        pick(btns[(i + (dx < 0 ? 1 : -1) + btns.length) % btns.length]);
      });
    });
    const pick = (b) => {
      if (b.getAttribute('aria-pressed') === 'true') return;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      name.textContent = b.dataset.name;
      text.textContent = b.dataset.note;
      note.style.animation = 'none'; void note.offsetWidth; note.style.animation = '';
    };
    btns.forEach((b) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('mouseenter', () => pick(b));
    });
    // macOS-style magnification (mouse only, decorative)
    if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      dock.addEventListener('mousemove', (e) => {
        const base = root.querySelector('.setup__screen').offsetWidth * 0.075;
        for (const b of btns) {
          const r = b.getBoundingClientRect();
          const d = Math.abs(e.clientX - (r.left + r.width / 2));
          b.style.setProperty('--s', `${Math.round(base * (1 + Math.max(0, 0.45 - d / 220)))}px`);
        }
      });
      dock.addEventListener('mouseleave', () => btns.forEach((b) => b.style.removeProperty('--s')));
    }
  }
</script>
