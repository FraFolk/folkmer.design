---
// "My setup": Francesca's real desktop (leaves wallpaper) with a working dock.
// Pick an app (hover, click or keyboard) and a note explains how it fits in her work.
import { url } from '../lib/url.js';

const apps = [
  { id: 'claude', name: 'Claude', icon: 'app-claude.png',
    note: 'My thinking partner. Research, synthesis, writing, and turning ideas into working prototypes in code. I decide, it speeds me up.' },
  { id: 'wispr', name: 'Wispr Flow', icon: 'app-wispr.png',
    note: 'I talk, it types. My test: 48 words per minute typing, 200 dictating. My keyboard is a bit jealous.' },
  { id: 'figma', name: 'Figma', icon: 'app-figma.png', unsure: true,
    note: 'Still my home for classic UI work, but I open it less every month. Will it stay in the dock? Ask me in a year.' },
  { id: 'chrome', name: 'Google Chrome', icon: 'app-chrome.png',
    note: 'Where everything gets tested: prototypes, accessibility checks, screen readers and keyboard-only runs.' },
  { id: 'spotify', name: 'Spotify', spotify: true,
    note: 'The soundtrack of every work session.' },
];
---
<section class="setup" aria-labelledby="setup-title" data-setup>

  <div class="setup__screen reveal">
    <img class="setup__wall" src={url('/img/setup-wallpaper.jpg')} alt="" loading="lazy" />
    <div class="setup__head">
      <h2 id="setup-title" class="h2">My setup</h2>
      <p>The desktop I work on every day. Pick an app to see how I use it.</p>
    </div>
    <div class="setup__note" aria-live="polite" data-setup-note>
      <p class="setup__note-app" data-setup-name>{apps[0].name}</p>
      <p data-setup-text>{apps[0].note}</p>
    </div>
    <ul class="setup__dock" data-setup-dock aria-label="Apps in my dock">
      {apps.map((a, i) => (
        <li class="setup__item">
          <button type="button" class="setup__app" aria-pressed={i === 0 ? 'true' : 'false'}
            data-name={a.name} data-note={a.note}>
            {a.icon
              ? <img src={url(`/img/${a.icon}`)} alt="" width="64" height="64" />
              : <span class="setup__spotify" aria-hidden="true" style={`--logo:url(${url('/img/icon-spotify.svg')})`}></span>}
            {a.unsure && <span class="setup__q" aria-hidden="true">?</span>}
            <span class="sr-only">{a.name}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .setup { display: flex; flex-direction: column; }
  .setup__head { position: absolute; top: 7%; left: 50%; transform: translateX(-50%); width: 90%; text-align: center; color: #fff; display: flex; flex-direction: column; gap: 6px; text-shadow: 0 2px 12px rgba(0,0,0,.45); }
  .setup__head p { color: rgba(255,255,255,.92); }
  .setup__screen { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-l, 40px); overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0,0,0,.45); }
  .setup__wall { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* the note: a scrap of paper in the middle of the desktop */
  .setup__note {
    position: absolute; left: 50%; top: 53%; width: min(380px, 70%);
    transform: translate(-50%, -50%) rotate(-2deg);
    background: #fbf8f0; color: #2a2f2d;
    padding: 22px 24px 24px; border-radius: 3px; font-size: 17px; line-height: 1.5; text-align: left;
    box-shadow: 0 2px 4px rgba(0,0,0,.15), 0 22px 40px -18px rgba(0,0,0,.55);
    animation: note-in .45s var(--ease-out);
  }
  .setup__note::before { content: ''; position: absolute; top: -12px; left: 50%; width: 90px; height: 24px; margin-left: -45px; background: rgba(255,255,255,.55); transform: rotate(3deg); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .setup__note-app { font: 500 28px/1 'Caveat', cursive; color: var(--orange-text); margin-bottom: 6px; }
  @keyframes note-in { from { opacity: 0; transform: translate(-50%, -46%) rotate(-4deg); } }

  .setup__dock {
    position: absolute; left: 50%; bottom: 4%; transform: translateX(-50%);
    list-style: none; margin: 0; padding: 8px 10px;
    display: flex; align-items: flex-end; gap: 6px;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 24px;
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  /* magnification changes the size (not a transform), so neighbours make room instead of overlapping */
  .setup__app {
    --s: 60px;
    position: relative; width: var(--s); height: var(--s); border: 0; padding: 0; cursor: pointer;
    background: none; display: block;
    transition: width .18s ease-out, height .18s ease-out;
  }
  .setup__app img { width: 100%; height: 100%; display: block; filter: drop-shadow(0 4px 6px rgba(0,0,0,.3)); }
  .setup__spotify { display: block; width: 84%; height: 84%; margin: 8%; border-radius: 22%; background: #121212; position: relative; box-shadow: 0 4px 8px -2px rgba(0,0,0,.4); }
  .setup__spotify::after { content: ''; position: absolute; inset: 16%; background: #1ed760; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .setup__app[aria-pressed='true']::after { content: ''; position: absolute; bottom: -6px; left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #fff; }
  .setup__app:focus-visible { outline: 3px solid #fff; outline-offset: 3px; border-radius: 14px; }
  .setup__q {
    position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; border-radius: 50%;
    background: var(--orange); color: #fff; font-weight: 700; font-size: 14px; display: grid; place-items: center;
  }

  @media (max-width: 700px) {
    .setup__screen { aspect-ratio: 3 / 4; }
    .setup__note { width: 84%; font-size: 15px; top: 52%; }
    .setup__head { top: 5%; }
    .setup__head .h2 { font-size: 28px; }
    .setup__app { --s: 44px; }
    .setup__dock { gap: 6px; padding: 6px 8px; border-radius: 18px; }
    .setup__q { width: 18px; height: 18px; font-size: 12px; top: -6px; right: -6px; }
  }
  @media (prefers-reduced-motion: reduce) { .setup__note { animation: none; } .setup__app { transition: none; } }
</style>

<script>
  for (const root of document.querySelectorAll('[data-setup]')) {
    const dock = root.querySelector('[data-setup-dock]');
    const btns = [...root.querySelectorAll('.setup__app')];
    const note = root.querySelector('[data-setup-note]');
    const name = root.querySelector('[data-setup-name]');
    const text = root.querySelector('[data-setup-text]');
    const pick = (b) => {
      if (b.getAttribute('aria-pressed') === 'true') return;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      name.textContent = b.dataset.name;
      text.textContent = b.dataset.note;
      note.style.animation = 'none'; void note.offsetWidth; note.style.animation = '';
    };
    btns.forEach((b) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('mouseenter', () => pick(b));
    });
    // macOS-style magnification (mouse only, decorative)
    if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      dock.addEventListener('mousemove', (e) => {
        const base = matchMedia('(max-width: 700px)').matches ? 44 : 60;
        for (const b of btns) {
          const r = b.getBoundingClientRect();
          const d = Math.abs(e.clientX - (r.left + r.width / 2));
          b.style.setProperty('--s', `${Math.round(base * (1 + Math.max(0, 0.45 - d / 220)))}px`);
        }
      });
      dock.addEventListener('mouseleave', () => btns.forEach((b) => b.style.removeProperty('--s')));
    }
  }
</script>
